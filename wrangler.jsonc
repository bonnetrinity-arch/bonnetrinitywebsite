{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bonnetrinitywebsite",
  "compatibility_date": "2026-09-19",
  "assets": {
    "directory": "./dist/public",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  }
}
